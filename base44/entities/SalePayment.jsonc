{
  "name": "SalePayment",
  "type": "object",
  "properties": {
    "sale_id": { "type": "string", "description": "ID da venda" },
    "sale_reference": { "type": "string", "description": "Referência da venda" },
    "payment_method": { "type": "string", "enum": ["dinheiro", "pix", "cartao_credito", "cartao_debito", "transferencia", "cheque"], "description": "Forma de pagamento" },
    "amount": { "type": "number", "description": "Valor pago" },
    "discount": { "type": "number", "default": 0, "description": "Valor do abatimento concedido neste pagamento" },
    "payment_date": { "type": "string", "format": "date", "description": "Data do pagamento" },
    "account_id": { "type": "string", "description": "Conta que recebeu o pagamento" },
    "notes": { "type": "string", "description": "Observações" },
    "company_id": { "type": "string" }
  },
  "required": ["sale_id", "payment_method", "amount", "company_id"],
  "rls": {
    "create": { "data.company_id": { "$in": "{{user.data.allowed_companies}}" } },
    "read": { "$or": [ { "data.company_id": { "$in": "{{user.data.allowed_companies}}" } }, { "user_condition": { "role": "admin" } } ] },
    "update": { "$or": [ { "data.company_id": { "$in": "{{user.data.allowed_companies}}" } }, { "user_condition": { "role": "admin" } } ] },
    "delete": { "$or": [ { "user_condition": { "role": "admin" } }, { "user_condition": { "custom_role": "admin" } } ] }
  }
}
