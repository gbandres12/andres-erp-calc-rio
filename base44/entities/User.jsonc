{
  "name": "User",
  "type": "object",
  "properties": {
    "allowed_companies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das empresas permitidas"
    },
    "custom_role": {
      "type": "string",
      "enum": [
        "admin",
        "operator",
        "scale_operator",
        "custom"
      ],
      "default": "operator",
      "description": "Perfil de acesso do ERP (não confundir com role admin/user do Base44)"
    },
    "custom_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Módulos (urls) permitidos quando custom_role = 'custom'"
    },
    "dark_mode": {
      "type": "boolean",
      "default": false,
      "description": "Preferência individual de tema escuro"
    },
    "settings": {
      "type": "object",
      "description": "Preferências individuais do usuário"
    }
  },
  "required": [
    "allowed_companies"
  ]
}
