{
  "name": "User",
  "type": "object",
  "properties": {
    "allowed_companies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das empresas permitidas"
    },
    "custom_role": {
      "type": "string",
      "enum": [
        "admin",
        "operator",
        "scale_operator"
      ],
      "default": "admin",
      "description": "Perfil de acesso"
    },
    "dark_mode": {
      "type": "boolean",
      "default": false,
      "description": "Prefer\u00eancia individual de tema escuro"
    },
    "settings": {
      "type": "object",
      "description": "Prefer\u00eancias individuais do usu\u00e1rio"
    }
  },
  "required": [
    "allowed_companies"
  ]
}