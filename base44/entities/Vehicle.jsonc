{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do ve\u00edculo (VEI001)"
    },
    "plate": {
      "type": "string",
      "description": "Placa do ve\u00edculo"
    },
    "brand": {
      "type": "string",
      "description": "Marca"
    },
    "model": {
      "type": "string",
      "description": "Modelo"
    },
    "year": {
      "type": "string",
      "description": "Ano"
    },
    "fleet_type": {
      "type": "string",
      "enum": [
        "propria",
        "agregada"
      ],
      "description": "Tipo de frota"
    },
    "capacity": {
      "type": "number",
      "description": "Capacidade em toneladas"
    },
    "odometer": {
      "type": "number",
      "description": "Hod\u00f4metro atual"
    },
    "driver_name": {
      "type": "string",
      "description": "Nome do motorista"
    },
    "driver_cpf": {
      "type": "string",
      "description": "CPF do motorista"
    },
    "driver_license": {
      "type": "string",
      "description": "N\u00famero da CNH do motorista"
    },
    "cnh_category": {
      "type": "string",
      "description": "Categoria da CNH (A, B, C, D, E ou combina\u00e7\u00e3o)"
    },
    "cnh_valid_until": {
      "type": "string",
      "format": "date",
      "description": "Data de validade da CNH"
    },
    "cnh_photo_url": {
      "type": "string",
      "description": "Foto da CNH (storage p\u00fablico)"
    },
    "truck_photo_url": {
      "type": "string",
      "description": "Foto do caminh\u00e3o (storage p\u00fablico)"
    },
    "bed_length_m": {
      "type": "number",
      "description": "Comprimento interno da ca\u00e7amba (m)"
    },
    "bed_width_m": {
      "type": "number",
      "description": "Largura interna da ca\u00e7amba (m)"
    },
    "bed_edge_height_m": {
      "type": "number",
      "description": "Altura da borda da ca\u00e7amba em rela\u00e7\u00e3o ao piso da ca\u00e7amba (m)"
    },
    "cost_center": {
      "type": "string",
      "description": "Centro de custo"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "rfid_tag": {
      "type": "string",
      "description": "Tag RFID"
    },
    "qr_code": {
      "type": "string",
      "description": "QR Code \u00fanico"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "parado",
        "manutencao",
        "inativo"
      ],
      "default": "ativo",
      "description": "Status do ve\u00edculo"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "code",
    "plate"
  ]
}