{
  "name": "TransactionPayment",
  "type": "object",
  "properties": {
    "transaction_id": { "type": "string", "description": "ID da transação principal" },
    "transaction_reference": { "type": "string", "description": "Referência da transação (cache)" },
    "amount": { "type": "number", "description": "Valor do pagamento/abatimento" },
    "discount": { "type": "number", "default": 0, "description": "Valor do desconto concedido neste pagamento" },
    "payment_date": { "type": "string", "format": "date", "description": "Data do pagamento" },
    "account_id": { "type": "string", "description": "ID da conta que recebeu/pagou" },
    "account_name": { "type": "string", "description": "Nome da conta (cache)" },
    "payment_method": { "type": "string", "enum": ["dinheiro", "pix", "transferencia", "cartao_debito", "cartao_credito", "cheque"], "description": "Forma de pagamento" },
    "responsible": { "type": "string", "description": "Responsável pelo lançamento" },
    "notes": { "type": "string", "description": "Observações" },
    "company_id": { "type": "string", "description": "ID da empresa" }
  },
  "required": ["transaction_id", "amount", "payment_date", "account_id", "company_id"],
  "rls": {
    "create": { "data.company_id": { "$in": "{{user.data.allowed_companies}}" } },
    "read": { "$or": [ { "data.company_id": { "$in": "{{user.data.allowed_companies}}" } }, { "user_condition": { "role": "admin" } } ] },
    "update": { "$or": [ { "data.company_id": { "$in": "{{user.data.allowed_companies}}" } }, { "user_condition": { "role": "admin" } } ] },
    "delete": { "$or": [ { "user_condition": { "role": "admin" } }, { "user_condition": { "custom_role": "admin" } } ] }
  }
}
